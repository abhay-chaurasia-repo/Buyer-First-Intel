# Supabase (browser-safe values only)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key

# Optional site URL used only for docs / local reference
# Edge Function SITE_URL secret controls Stripe redirect URLs
VITE_SITE_URL=http://localhost:5173

# Set to "false" to force demo subscribe RPC instead of Stripe Checkout
# VITE_STRIPE_CHECKOUT_ENABLED=false

# Property data (address search + ATTOM)
# Server-only keys — do NOT use VITE_ prefix (never ship to the browser)
# ATTOM_API_KEY=your_attom_key
# GOOGLE_MAPS_API_KEY=your_maps_platform_key
#
# Google Places (New) powers address typeahead. For the Vite/Edge proxy:
# - Application restrictions: None (or IP) — NOT "Websites" (server calls have no referrer)
# - API restrictions: Places API (New), Geocoding API, Address Validation API
# - Billing must be enabled on the Google Cloud project
#
# Deploy production path:
#   supabase functions deploy property-lookup
#   supabase secrets set ATTOM_API_KEY=your_attom_key
#   supabase secrets set GOOGLE_MAPS_API_KEY=your_maps_platform_key
# See supabase/PROPERTY_DATA.md
