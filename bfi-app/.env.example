# Supabase (browser-safe values only)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key

# Optional site URL used only for docs / local reference
# Edge Function SITE_URL secret controls Stripe redirect URLs
VITE_SITE_URL=http://localhost:5173

# Set to "false" to force demo subscribe RPC instead of Stripe Checkout
# VITE_STRIPE_CHECKOUT_ENABLED=false

# Property data (address search works client-side via Census; ATTOM is server-only)
# Deploy: supabase functions deploy property-lookup
# Then: supabase secrets set ATTOM_API_KEY=your_attom_key
# See supabase/PROPERTY_DATA.md
